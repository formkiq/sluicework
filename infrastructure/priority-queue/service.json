{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Outbound-only Sluicework repository priority dispatcher (ARM64 Go Lambda)",
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "CodeVersion": {
      "Type": "String"
    },
    "AppKeySecretArn": {
      "Type": "String"
    },
    "QueueConfig": {
      "Type": "String"
    },
    "Enabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "DispatchEnabled": {
      "Fn::Equals": [
        {
          "Ref": "Enabled"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "Queue": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          },
          {
            "AttributeName": "active",
            "AttributeType": "S"
          },
          {
            "AttributeName": "created",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "active-requests",
            "KeySchema": [
              {
                "AttributeName": "active",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "created",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "QueueOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Queue",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${Queue.Arn}/index/active-requests"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "AppKeySecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Dispatcher": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "provided.al2023",
        "Handler": "bootstrap",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 55,
        "ReservedConcurrentExecutions": 1,
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          },
          "S3ObjectVersion": {
            "Ref": "CodeVersion"
          }
        },
        "Environment": {
          "Variables": {
            "QUEUE_TABLE": {
              "Ref": "Queue"
            },
            "QUEUE_CONFIG": {
              "Ref": "QueueConfig"
            },
            "GITHUB_KEY_SECRET_ARN": {
              "Ref": "AppKeySecretArn"
            }
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "Logs"
          }
        }
      }
    },
    "Clock": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(1 minute)",
        "State": {
          "Fn::If": [
            "DispatchEnabled",
            "ENABLED",
            "DISABLED"
          ]
        },
        "Targets": [
          {
            "Id": "QueueDispatcher",
            "Arn": {
              "Fn::GetAtt": [
                "Dispatcher",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumEventAgeInSeconds": 120,
              "MaximumRetryAttempts": 1
            }
          }
        ]
      }
    },
    "ClockPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Dispatcher"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "Clock",
            "Arn"
          ]
        }
      }
    },
    "Errors": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Priority dispatcher errors; investigate before queue deadlines pass",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "Dispatcher"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "Dispatcher"
      }
    },
    "QueueTable": {
      "Value": {
        "Ref": "Queue"
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "Logs"
      }
    },
    "ClockRule": {
      "Value": {
        "Ref": "Clock"
      }
    }
  }
}
